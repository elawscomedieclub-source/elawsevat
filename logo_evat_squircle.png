<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" width="100" height="100">
  <!-- Fond circulaire noir -->
  <circle cx="50" cy="50" r="48" fill="#030712" stroke="#0ea5e9" stroke-width="4"/>
  <!-- Cercle pointillé vert émeraude -->
  <circle cx="50" cy="50" r="30" fill="none" stroke="#10b981" stroke-width="3" stroke-dasharray="6,4"/>
  <!-- Texte EVAT (pour le SVG, peut être utile) -->
  <text x="50" y="55" font-family="system-ui, -apple-system, sans-serif" font-size="22" font-weight="bold" fill="#0ea5e9" text-anchor="middle">EVAT</text>
</svg>
